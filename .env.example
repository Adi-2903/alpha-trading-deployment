# Copy to .env and fill in a NEW, DEDICATED PAPER account's keys from
# https://app.alpaca.markets (Paper Trading, top-right account switcher).
# The hackathon playbook requires a fresh paper account created for this
# event -- don't reuse an existing one. Never commit .env or paste real
# keys into chat/screenshots.
#
# These two names are exactly what the Alpaca CLI itself reads
# (github.com/alpacahq/cli) -- alpaca_client.py passes them straight
# through to the `alpaca` binary's subprocess environment, so setting
# them here is enough for both this project AND for running `alpaca ...`
# commands by hand in the same shell.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# 'indicative' works without an options market-data subscription;
# switch to 'opra' if the paper account has an OPRA data plan.
ALPACA_OPTION_FEED=indicative
# free accounts get 'iex'; use 'sip' if the account has that add-on.
ALPACA_STOCK_FEED=iex

# -- what to trade --
SYMBOL=SPY
TARGET_DTE_DAYS=7
DTE_TOLERANCE_DAYS=3
SHORT_LEG_TARGET_DELTA=0.16
WING_TARGET_DELTA=0.05

# -- safety: the agent computes and logs everything either way; this only
# gates the final order submission. Leave true until you've reviewed a
# few /run responses (or `python cli.py run`) and are comfortable with
# what it's proposing. --
DRY_RUN=true
# Leave false. Only set true if you deliberately intend to let the
# Alpaca CLI route to live trading (which additionally requires
# ALPACA_LIVE_TRADE=true in the environment -- see README "Safety").
I_UNDERSTAND_THIS_IS_LIVE=false
ENABLE_CREDIT_SPREADS=true
ENABLE_EQUITY_HEDGE=true
MIN_OPEN_INTEREST=10

# -- v2: cross-checks/gates, each degrades gracefully to v1 behavior when
# disabled or when its own data requirements aren't met this cycle --
# see research/heston_signal.py, research/toxicity.py, and
# strategy/sizing.py's cost-floor docstring.
ENABLE_HESTON_CROSS_CHECK=true
ENABLE_TOXICITY_GATE=true
ENABLE_COST_FLOOR=true

# -- portfolio-overlay risk budget (fractions of live account equity) --
MAX_GAMMA_RISK_PCT=0.0005
MAX_VEGA_RISK_PCT=0.02
TARGET_PORTFOLIO_VOL=0.12
MAX_DRAWDOWN_PCT=0.25
KELLY_FRACTION=0.25
KELLY_CLIP=0.15
MAX_CONTRACTS_PER_LEG=20

# -- hedging (Leland / Whalley-Wilmott, pricing_engine/risk/friction_hedging.py) --
TRANSACTION_COST_BPS=5
HEDGE_RISK_AVERSION=1.0
REHEDGE_MIN_INTERVAL_MIN=30
MIN_VARIANCE_LOOKBACK_DAYS=20
